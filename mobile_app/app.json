{
  "expo": {
    "name": "AgriGuard",
    "slug": "agriguard-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.arslan.agriguard",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}